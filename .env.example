# Environment Configuration for YouTube Shorts Clipper (yt_upl2)

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
SECRET_KEY=replace-with-a-random-secret-key

# YouTube API & OAuth
YOUTUBE_API_KEY=your_youtube_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
# Groq AI API Key (for transcript highlight scoring and clip titles/descriptions)
GROQ_API_KEY=your_groq_api_key_here

# Redis Queue (RQ) Connection URL
REDIS_URL=redis://localhost:6379/0

# Database URI (SQLite by default)
SQLALCHEMY_DATABASE_URI=sqlite:///yt_upl2.db
